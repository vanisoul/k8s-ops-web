{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "通知事件設定",
  "type": "object",
  "required": ["hooks"],
  "properties": {
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "message", "providers"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["available", "unavailable", "logRegex"] },
          "message": { "type": "string", "minLength": 1 },
          "providers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "regex": { "type": "string", "minLength": 1 },
          "bufferLimit": { "type": "integer", "minimum": 1, "default": 20 }
        },
        "allOf": [{ "if": { "properties": { "type": { "const": "logRegex" } }, "required": ["type"] }, "then": { "required": ["regex"] } }]
      }
    }
  }
}
